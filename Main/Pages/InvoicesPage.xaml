<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    x:Class="Main.Pages.InvoicesPage"
    Title="Factures">

        <ContentPage.BindingContext>
            <vm:InvoicesViewModel />
        </ContentPage.BindingContext>

    <Grid>
        <ScrollView >
            <Grid RowDefinitions="Auto,*,Auto">
                <Label 
                Grid.Row="0" 
                Text="Factures"
                Style="{StaticResource LabelHeader}"
                HorizontalOptions="Center"
                VerticalTextAlignment="Center">
                </Label>

                <Border Grid.Row="1" Style="{StaticResource BorderList}" Margin="6" StrokeShape="RoundRectangle 12">

                    <CollectionView 
                        BackgroundColor="White"
                        ItemsSource="{Binding Invoices}"
                        SelectionMode="None"
                        VerticalOptions="Fill"
                        >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InvoicesViewModel}}, Path=ClickEditInvoice}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        
                                        <Label Grid.Column="0" Style="{StaticResource LabelItem}" Text="{Binding EffectiveOn, StringFormat='{0:dd/MM/yyyy}'}" />
                                        <Label Grid.Column="1" Style="{StaticResource LabelItem}" Text="{Binding Supplier}" />
                                        <Label Grid.Column="2" Style="{StaticResource LabelItemAmount}" Text="{Binding Amount, StringFormat='{0:N2} €'}" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Style="{StaticResource BoxViewLine}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>


            </Grid>
        </ScrollView>
        <Button 
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="20"
            WidthRequest="36"
            HeightRequest="36"
            ImageSource="{StaticResource IconAdd}"
            Style="{StaticResource ButtonFloatingOk}"
            Command="{Binding ClickAddInvoice}" />
    </Grid>

</ContentPage>
