<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    x:Class="Main.Pages.MaintenancesPage"
    Title="Maintenance">
    
    <ContentPage.BindingContext>
        <vm:MaintenancesViewModel />
    </ContentPage.BindingContext>

    <Grid>
        <ScrollView Margin="10" BackgroundColor="AliceBlue">
            <Grid BackgroundColor="AliceBlue" RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                <Label 
                Grid.Row="0" 
                Text="{Binding Titel}"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="#333"
                />

                <Border Grid.Row="2" Margin="0" Padding="12" Background="White">

                    <CollectionView
                    Grid.Row="2"
                    ItemsSource="{Binding Items}"
                    SelectionMode="None"
                    Margin="20,0,20,0">

                        <CollectionView.Header>
                                <Label FontSize="12" Text="Name"  FontAttributes="Bold" HorizontalOptions="Start"/>
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="0">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer
                                        NumberOfTapsRequired="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MaintenancesViewModel}}, Path=ClickItem}"
                                        CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>
                                    <Label Text="{Binding Name}" FontSize="12" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />

                                    <BoxView HeightRequest="1" BackgroundColor="#DADADA" Margin="0,4,0,4" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                </Border>
            </Grid>
        </ScrollView>
        <Button 
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="20"
            WidthRequest="36"
            HeightRequest="36"
            ImageSource="{StaticResource IconAdd}"
            Style="{StaticResource ButtonFloatingOk}"
            Command="{Binding ClickAdd}" />
    </Grid>
</ContentPage>