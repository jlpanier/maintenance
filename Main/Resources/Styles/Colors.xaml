<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--Palette
        Vert principal : #4CAF50
        Vert foncé : #388E3C
        Vert clair : #C8E6C9    
        Blanc cassé : #FAFAFA
        Gris texte : #333333

        🧩 Usage MAUI
        Bouton flottant : #4CAF50
        Hover / press : #388E3C
        Fond du menu : #FAFAFA
        Bordures : #C8E6C9
    
    00695C
    -->
    
    <!--background color-->
    <Color x:Key="PrimaryDark">#00695C</Color>
    <Color x:Key="Background">#C8E6C9</Color>
    <Color x:Key="StrokeColor">#C8E6C9</Color>
    <Color x:Key="ShadowColor">#C8E6C9</Color>
    <Color x:Key="TextColor">#333333</Color>
    <Color x:Key="TextColorAmount">#00695C</Color>

    <!--Vert principal-->
    <Color x:Key="Primary">#4CAF50</Color> 
    <Color x:Key="PrimaryDarkText">#333333</Color>


    <Color x:Key="White">#FAFAFA</Color>
    <Color x:Key="Black">Black</Color>

    <Color x:Key="LightOnDarkBackground">#C8E6C9</Color>
    <!--Vert foncé-->
    <Color x:Key="DarkOnLightBackground">#388E3C</Color>

</ResourceDictionary>