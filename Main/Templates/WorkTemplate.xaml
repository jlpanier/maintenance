<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Main.ViewModels"
    x:Class="Main.Templates.WorkTemplate">

    <VerticalStackLayout Margin="6,0" Spacing="0">
        <VerticalStackLayout.GestureRecognizers>
            <TapGestureRecognizer 
                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ClickWork}"
                CommandParameter="{Binding}" />
        </VerticalStackLayout.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*" >
            <Image 
                Grid.Column="0" 
                Source="{Binding ImagePath}"
                Aspect="AspectFit"
                Margin="6"
                WidthRequest="{Binding WidthRequest}"
                HeightRequest="{Binding HeightRequest}"
                />
            <VerticalStackLayout Grid.Column="1" Spacing="0" Margin="0,6,6,0">
                <Grid ColumnDefinitions="*,Auto" >
                    <Label
                        Grid.Column="0"
                        Text="{Binding EffectiveOn, StringFormat='{0:dd/MM/yyyy}'}"
                        Style="{StaticResource LabelItem}" 
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        FontAttributes="Bold"
                        Margin="0"
                        Padding="0"
                        />

                    <Label 
                        Grid.Column="1"
                        Text="{Binding TotalAmount, StringFormat='{0:N2} €'}"
                        Style="{StaticResource LabelItemAmount}"
                        FontAttributes="Bold"
                        Margin="0"
                        Padding="0"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        />
                </Grid>
                <Label 
                    Text="{Binding Supplier}"
                    Style="{StaticResource LabelItemSupplier}" 
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    FontAttributes="Italic"
                    Margin="0"
                    Padding="0"
                    />
                <Label 
                    Text="{Binding Desc}"
                    Style="{StaticResource LabelItemDesc}"
                    Padding="0"
                    Margin="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    />

            </VerticalStackLayout>
        </Grid>
        
        <BoxView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource BoxViewLine}" />
        
    </VerticalStackLayout>

</ContentView>
